#!/usr/bin/env bash
# MyTracker — Gradle wrapper bootstrap script
# Auto-downloads gradle-wrapper.jar from gradle/gradle GitHub if missing,
# then runs Gradle via the wrapper jar.
# This script is committed to the repo so users don't need to manually install Gradle.

set -e

APP_HOME=$(cd "$(dirname "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"
GRADLE_VERSION="8.7"
GRADLE_DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"

# Auto-download gradle-wrapper.jar if missing (binary file, not committed to repo)
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "gradle-wrapper.jar missing, downloading from gradle/gradle GitHub…"
  mkdir -p "$APP_HOME/gradle/wrapper"
  curl -fsSL -o "$WRAPPER_JAR" \
    "https://raw.githubusercontent.com/gradle/gradle/v${GRADLE_VERSION}/gradle/wrapper/gradle-wrapper.jar"
fi

# Write default wrapper properties if missing
if [ ! -f "$WRAPPER_PROPS" ]; then
  cat > "$WRAPPER_PROPS" <<EOF
distributionBase=GRADLE_USER_HOME
distributionPath=wrapper/dists
distributionUrl=${GRADLE_DIST_URL}
networkTimeout=10000
zipStoreBase=GRADLE_USER_HOME
zipStorePath=wrapper/dists
EOF
fi

# Execute Gradle wrapper jar
if command -v java >/dev/null 2>&1; then
  exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
else
  echo "Java is required to run Gradle. Please install Java 17+."
  exit 1
fi
